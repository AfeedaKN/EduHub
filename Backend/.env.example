# ===================================================================
# EduHub Backend Environment Configuration Template
# Copy this file to .env and configure your values.
# ===================================================================

# Application Environment & Port
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/eduhub
CLIENT_URL=http://localhost:5173

# JWT Security
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRY_DAYS=7

# Cookie Configuration
COOKIE_NAME=eduhub_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email / SMTP Configuration (Optional in Dev - falls back to Console Logger)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EduHub School <no-reply@eduhub.school>"

# Frontend URLs for Links
PASSWORD_RESET_URL=http://localhost:5173/reset-password
VERIFICATION_URL=http://localhost:5173/verify-email

# Initial Management Account Credentials (used by scripts/createInitialManagement.ts)
INITIAL_MANAGEMENT_NAME="Principal Administrator"
INITIAL_MANAGEMENT_EMAIL=admin@eduhub.school
INITIAL_MANAGEMENT_PASSWORD=EduHubAdmin@2026!
INITIAL_MANAGEMENT_PHONE="+1234567890"
